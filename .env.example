# --- Database ---
# Postgres connection string (e.g. Supabase → Project Settings → Database → Connection string, "Transaction pooler").
# Leave unset for local development: an embedded PGlite database is created in ./.data/pglite
# DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres
# Set to "false" to skip automatic migrations on boot (run them in CI instead).
# DB_AUTO_MIGRATE=true

# --- Admin bootstrap ---
# Comma-separated emails that become admins when they register or sign in.
ADMIN_EMAILS=you@example.com

# --- Public URL (used for metadata / Open Graph) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Billing (optional). With these unset, every feature is free ("early access"). ---
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_PRICE_ID=price_...              # recurring price for the Pro plan
# STRIPE_WEBHOOK_SECRET=whsec_...        # endpoint: /api/stripe/webhook
# NEXT_PUBLIC_PRO_PRICE_LABEL=$14.99 / month
# PAYWALL=on|off                         # force the paywall on/off regardless of Stripe config
